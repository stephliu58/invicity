{
  "color": {
    "deep-forest": "#16211b",
    "forest": "#2a3a31",
    "ivory": "#f3f1ec",
    "sage": "#b6c7a1",
    "sage-dim": "#9fb287",
    "champagne": "#d9c7a4",
    "text-muted-dark": "rgba(243,241,236,0.70)",
    "text-muted-light": "rgba(22,33,27,0.72)",
    "steel-text-dark": "#98a1ac",
    "steel-text-light": "#5c6570",
    "hairline-dark": "rgba(182,199,161,0.22)",
